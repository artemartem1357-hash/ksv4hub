local function applyOverworldHitbox(tool)

if not tool then return end

for _, desc in ipairs(tool:GetDescendants()) do

if desc:IsA("BasePart") then

desc.Size = Vector3.new(MAP_HITBOX_SIZE, MAP_HITBOX_SIZE, MAP_HITBOX_SIZE)

desc.CanCollide = false

desc.Massless = true

desc.AssemblyLinearVelocity = Vector3.new(0, 0, 0)


if SHOW_HITBOX_VISUAL then

desc.Transparency = 0.6

desc.Color = Color3.fromRGB(200, 0, 255)

desc.Material = Enum.Material.Neon

else

desc.Transparency = 1

end

end

if desc:IsA("SpecialMesh") then

desc.Scale = Vector3.new(MAP_HITBOX_SIZE, MAP_HITBOX_SIZE, MAP_HITBOX_SIZE)

end

end

end



local function checkHealthPhase(hum)

if not hum then return "normal" end


local hp = hum.Health

local maxHp = hum.MaxHealth


local isHpInf = (hp == math.huge or string.lower(tostring(hp)) == "inf" or hp > 1e18)

local isMaxHpInf = (maxHp == math.huge or string.lower(tostring(maxHp)) == "inf" or maxHp > 1e18)


local char = LocalPlayer.Character

local tool = char and char:FindFirstChild(SACRIFICE_SWORD)

local phaseValue = 0

if tool then

local phasesFolder = tool:FindFirstChild("Phases")

if phasesFolder then

local pNum = phasesFolder:FindFirstChild("Phase#")

if pNum and pNum:IsA("ValueBase") then

phaseValue = tonumber(pNum.Value) or 0

end

end

end



if phaseValue >= 5 or (isHpInf and isMaxHpInf and phaseValue > 4) then

return "sacrifice"

elseif isHpInf or isMaxHpInf or phaseValue == 4 then

return "existential"

end


return "normal"

end



local function executeGuaranteedInteractions(targetPos)

local startTime = tick()


while tick() - startTime < 3.0 do

safeTeleport(targetPos)


for _, prompt in ipairs(workspace:GetDescendants()) do

if prompt:IsA("ProximityPrompt") and prompt.Parent and prompt.Parent:IsA("BasePart") then

if (targetPos - prompt.Parent.Position).Magnitude < 80 then

prompt.RequiresLineOfSight = false

prompt.MaxActivationDistance = 100


if fireproximityprompt then

fireproximityprompt(prompt)

else

prompt:InputHoldBegin()

task.wait(prompt.HoldDuration + 0.05)

prompt:InputHoldEnd()

end

end

end

end



for _, desc in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do

if desc:IsA("RemoteEvent") then

local lowerName = string.lower(desc.Name)

if string.find(lowerName, "sacrifice") or string.find(lowerName, "descension") or string.find(lowerName, "existential") then

desc:FireServer()

end

end

end


task.wait(0.2)

end

end



local function goToExistentialStage()

if not running or existentialTriggered then return false end

existentialTriggered = true



print("[AUTOFARM] Infinite HP Detected! Teleporting to Existential Position...")

executeGuaranteedInteractions(EXISTENTIAL_POSITION)

return true

end



