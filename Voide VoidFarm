local function applyOverworldHitbox(tool)

if not tool then return end

for _, desc in ipairs(tool:GetDescendants()) do

if desc:IsA("BasePart") then

desc.Size = Vector3.new(MAP_HITBOX_SIZE, MAP_HITBOX_SIZE, MAP_HITBOX_SIZE)

desc.CanCollide = false

desc.Massless = true

desc.AssemblyLinearVelocity = Vector3.new(0, 0, 0)


if SHOW_HITBOX_VISUAL then

desc.Transparency = 0.6

desc.Color = Color3.fromRGB(200, 0, 255)

desc.Material = Enum.Material.Neon

else

desc.Transparency = 1

end

end

if desc:IsA("SpecialMesh") then

desc.Scale = Vector3.new(MAP_HITBOX_SIZE, MAP_HITBOX_SIZE, MAP_HITBOX_SIZE)

end

end

end



local function checkHealthPhase(hum)

if not hum then return "normal" end


local hp = hum.Health

local maxHp = hum.MaxHealth


local isHpInf = (hp == math.huge or string.lower(tostring(hp)) == "inf" or hp > 1e18)

local isMaxHpInf = (maxHp == math.huge or string.lower(tostring(maxHp)) == "inf" or maxHp > 1e18)


local char = LocalPlayer.Character

local tool = char and char:FindFirstChild(SACRIFICE_SWORD)

local phaseValue = 0

if tool then

local phasesFolder = tool:FindFirstChild("Phases")

if phasesFolder then

local pNum = phasesFolder:FindFirstChild("Phase#")

if pNum and pNum:IsA("ValueBase") then

phaseValue = tonumber(pNum.Value) or 0

end

end

end



if phaseValue >= 5 or (isHpInf and isMaxHpInf and phaseValue > 4) then

return "sacrifice"

elseif isHpInf or isMaxHpInf or phaseValue == 4 then

return "existential"

end


return "normal"

end



