-- Shared Utility Function: Teleport & Collection Loop with Min Distance Check
local function runFarmLoop(stateTable, useItemFunc, minDistToSkip)
    task.spawn(function()
        while true do
            if stateTable.Enabled then
                pcall(function()
                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")

                    if root and #stateTable.Queue > 0 then
                        local i = 1
                        while i <= #stateTable.Queue do
                            if not stateTable.Enabled then break end

                            local data = stateTable.Queue[i]
                            local targetPart = data and data.Part
                            local prompt = data and data.Prompt

                            if targetPart and targetPart.Parent and targetPart:IsDescendantOf(Workspace) and not stateTable.Blacklist[targetPart] then
                                if minDistToSkip then
                                    local dist = (root.Position - targetPart.Position).Magnitude
                                    if dist <= minDistToSkip then
                                        if prompt and prompt.Parent and prompt.Enabled then
                                            pcall(function()
                                                prompt.HoldDuration = 0
                                                prompt.MaxActivationDistance = 999999
                                                prompt.RequiresLineOfSight = false
                                                safeFireProximityPrompt(prompt)
                                            end)
                                        end
                                        pcall(function()
                                            safeFireTouchInterest(targetPart, root, 0)
                                            safeFireTouchInterest(targetPart, root, 1)
                                        end)
                                        if useItemFunc then useItemFunc() end
                                        table.remove(stateTable.Queue, i)
                                        task.wait(0.1)
                                        continue
                                    end
                                end

                                if not stateTable.Attempts[targetPart] then
                                    stateTable.Attempts[targetPart] = 0
                                end

                                if stateTable.Attempts[targetPart] >= 4 then
                                    stateTable.Attempts[targetPart] = 0
                                    local stuckItem = table.remove(stateTable.Queue, i)
                                    if stuckItem then
                                        table.insert(stateTable.Queue, stuckItem)
                                    end
                                    continue
                                end

                                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                root.CFrame = targetPart.CFrame + Vector3.new(0, 0.5, 0)

                                RunService.Heartbeat:Wait()

                                for step = 1, 6 do
                                    if not targetPart or not targetPart.Parent or not targetPart:IsDescendantOf(Workspace) then
                                        break
                                    end

                                    if prompt and prompt.Parent and prompt.Enabled then
                                        pcall(function()
                                            prompt.HoldDuration = 0
                                            prompt.MaxActivationDistance = 999999
                                            prompt.RequiresLineOfSight = false
                                            safeFireProximityPrompt(prompt)
                                        end)
                                    end

                                    pcall(function()
                                        safeFireTouchInterest(targetPart, root, 0)
                                        safeFireTouchInterest(targetPart, root, 1)
                                    end)

                                    task.wait(0.03)
                                end

                                if useItemFunc then
                                    useItemFunc()
                                end

                                if not targetPart or not targetPart.Parent or not targetPart:IsDescendantOf(Workspace) then
                                    stateTable.Attempts[targetPart] = nil
                                    local hl = targetPart:FindFirstChild("FarmHighlight")
                                    if hl then hl:Destroy() end
                                    table.remove(stateTable.Queue, i)
                                else
                                    stateTable.Attempts[targetPart] = stateTable.Attempts[targetPart] + 1
                                    i = i + 1
                                end

                                task.wait(stateTable.TPDelay)
                            else
                                table.remove(stateTable.Queue, i)
                            end
                        end
                    end
                end)
            end
            task.wait(0.1)
        end
    end)
end

-- ESP Handler
local function setupESP(stateTable, fillColor)
    task.spawn(function()
        while true do
            if stateTable.ESPEnabled and stateTable.Enabled then
                pcall(function()
                    for _, data in ipairs(stateTable.Queue) do
                        local part = data.Part
                        if part and part.Parent and not part:FindFirstChild("FarmHighlight") and not stateTable.Blacklist[part] then
                            local highlight = Instance.new("Highlight")
                            highlight.Name = "FarmHighlight"
                            highlight.Adornee = part
                            highlight.FillColor = fillColor
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            highlight.FillTransparency = 0.3
                            highlight.OutlineTransparency = 0
                            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            highlight.Parent = part
                        end
                    end
                end)
            else
                pcall(function()
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if obj.Name == "FarmHighlight" then obj:Destroy() end
                    end
                end)
            end
            task.wait(1.5)
        end
    end)
end

-- ==================== CANDY CONFIG ====================
local CandyState = { Enabled = false, ESPEnabled = true, AutoEat = false, TPDelay = 0.08, Blacklist = {}, Attempts = {}, Queue = {} }

local function extractCandyData(container, state)
    if not container or not container.Parent or state.Blacklist[container] then return nil end
    if container:IsA("Model") and (container:FindFirstChildOfClass("Humanoid") or Players:GetPlayerFromCharacter(container)) then return nil end

    local prompt = container:FindFirstChildWhichIsA("ProximityPrompt", true)
    local touch = container:FindFirstChildWhichIsA("TouchTransmitter", true)
    local targetPart = nil

    if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
        targetPart = prompt.Parent
    elseif touch and touch.Parent and touch.Parent:IsA("BasePart") then
        targetPart = touch.Parent
    elseif container:IsA("Model") then
        targetPart = container.PrimaryPart or container:FindFirstChildWhichIsA("BasePart", true)
    elseif container:IsA("BasePart") then
        targetPart = container
    end

    if targetPart and targetPart:IsA("BasePart") and not state.Blacklist[targetPart] then
        if not prompt then
            prompt = targetPart:FindFirstChildOfClass("ProximityPrompt") or (targetPart.Parent and targetPart.Parent:FindFirstChildOfClass("ProximityPrompt"))
        end
        return { Part = targetPart, Prompt = prompt, Source = container }
    end
    return nil
end

local function rescanCandyFolders()
    pcall(function()
        local activeParts = {}
        local function addUnique(data)
            if data and data.Part then
                activeParts[data.Part] = true
                for _, existing in ipairs(CandyState.Queue) do
                    if existing.Part == data.Part then return end
                end
                table.insert(CandyState.Queue, data)
            end
        end

        local candySearch = Workspace:FindFirstChild("OthersSpecialEvents") and Workspace.OthersSpecialEvents:FindFirstChild("CandySearch")
        if candySearch then
            for _, spawnSlot in ipairs(candySearch:GetChildren()) do
                for _, child in ipairs(spawnSlot:GetChildren()) do
                    if child.Name ~= "Spawn" and not child:IsA("Attachment") then
                        local data = extractCandyData(child, CandyState)
                        if data then addUnique(data) end
                    end
                end
            end
        end

        local spawnedCandies = Workspace:FindFirstChild("SpawnedCandies")
        if spawnedCandies then
            for _, candyObj in ipairs(spawnedCandies:GetChildren()) do
                local data = extractCandyData(candyObj, CandyState)
                if data then addUnique(data) end
            end
        end

        for i = #CandyState.Queue, 1, -1 do
            local item = CandyState.Queue[i]
            if not item or not item.Part or not activeParts[item.Part] then
                table.remove(CandyState.Queue, i)
            end
        end
    end)
end

task.spawn(function()
    while true do
        if CandyState.Enabled then rescanCandyFolders() end
        task.wait(0.8)
    end
end)

