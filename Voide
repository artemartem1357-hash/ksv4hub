-- ==================== POLYFILLS ====================
local fireprompt = fireproximityprompt
local firetouch  = firetouchinterest

local function safeFirePrompt(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return end
    if fireprompt then
        pcall(fireprompt, prompt)
    else
        pcall(function()
            prompt.HoldDuration = 0
            prompt:InputHoldBegin()
            task.wait(0.01)
            prompt:InputHoldEnd()
        end)
    end
end

local function safeTouch(part, other)
    if firetouch then
        pcall(firetouch, part, other, 0)
        pcall(firetouch, part, other, 1)
    end
end

-- ==================== PROMPT HOOK (event + one sweep) ====================
local function patchPrompt(p)
    if not p or not p:IsA("ProximityPrompt") then return end
    p.HoldDuration = 0
    p.MaxActivationDistance = 999999
    p.RequiresLineOfSight = false
end

task.spawn(function()
    while true do
        if GlobalState.InstantPromptsEnabled then
            for _, d in ipairs(Workspace:GetDescendants()) do
                if d:IsA("ProximityPrompt") then patchPrompt(d) end
            end
        end
        task.wait(2)
    end
end)

Workspace.DescendantAdded:Connect(function(d)
    if GlobalState.InstantPromptsEnabled and d:IsA("ProximityPrompt") then
        patchPrompt(d)
    end
end)

-- ==================== QUEUE ENGINE (race-safe) ====================
-- single writer discipline: only the farm loop mutates Queue during iteration.
-- rescan pushes into a staging table, loop swaps under a shared lock flag.

local function newState(tp_delay)
    return {
        Enabled = false,
        ESPEnabled = true,
        TPDelay = tp_delay or 0.08,
        Blacklist = {},
        Attempts = {},
        Queue = {},
        _staging = {},
        _lock = false,
    }
end

local function pushToStaging(state, data)
    if not data or not data.Part then return end
    for _, e in ipairs(state._staging) do
        if e.Part == data.Part then return end
    end
    state._staging[#state._staging + 1] = data
end

local function commitStaging(state)
    if state._lock then return end
    state._lock = true
    for _, data in ipairs(state._staging) do
        local dup = false
        for _, e in ipairs(state.Queue) do
            if e.Part == data.Part then dup = true; break end
        end
        if not dup then state.Queue[#state.Queue + 1] = data end
    end
    state._staging = {}
    state._lock = false
end

local function pruneDead(state)
    for i = #state.Queue, 1, -1 do
        local e = state.Queue[i]
        if not e or not e.Part or not e.Part.Parent or not e.Part:IsDescendantOf(Workspace) then
            state.Attempts[e and e.Part] = nil
            table.remove(state.Queue, i)
        end
    end
end

local function farmLoop(state, onCollect, min_dist)
    task.spawn(function()
        while true do
            if state.Enabled and not state._lock and #state.Queue > 0 then
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    local i = 1
                    while i <= #state.Queue and state.Enabled do
                        local e = state.Queue[i]
                        local part = e.Part
                        if part and part.Parent and part:IsDescendantOf(Workspace) and not state.Blacklist[part] then
                            local skip = false
                            if min_dist then
                                local d = (root.Position - part.Position).Magnitude
                                if d <= min_dist then
                                    safeFirePrompt(e.Prompt)
                                    safeTouch(part, root)
                                    if onCollect then onCollect() end
                                    table.remove(state.Queue, i)
                                    skip = true
                                    task.wait(0.05)
                                end
                            end
                            if not skip then
                                local att = (state.Attempts[part] or 0) + 1
                                state.Attempts[part] = att
                                if att > 4 then
                                    state.Attempts[part] = 0
                                    table.remove(state.Queue, i)
                                    state.Queue[#state.Queue + 1] = e   -- rotate to back
                                else
                                    root.AssemblyLinearVelocity = Vector3.zero
                                    root.AssemblyAngularVelocity = Vector3.zero
                                    root.CFrame = part.CFrame + Vector3.new(0, 0.5, 0)
                                    RunService.Heartbeat:Wait()
                                    for _ = 1, 5 do
                                        if not part.Parent then break end
                                        safeFirePrompt(e.Prompt)
                                        safeTouch(part, root)
                                        task.wait(0.03)
                                    end
                                    if onCollect then onCollect() end
                                    if not part.Parent then
                                        state.Attempts[part] = nil
                                        table.remove(state.Queue, i)
                                    else
                                        i = i + 1
                                    end
                                end
                                task.wait(state.TPDelay)
                            end
                        else
                            table.remove(state.Queue, i)
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

local function setupESP(state, color)
    task.spawn(function()
        while true do
            if state.ESPEnabled and state.Enabled then
                for _, e in ipairs(state.Queue) do
                    local part = e.Part
                    if part and part.Parent and not part:FindFirstChild("FarmHighlight") then
                        local h = Instance.new("Highlight")
                        h.Name = "FarmHighlight"
                        h.Adornee = part
                        h.FillColor = color
                        h.OutlineColor = Color3.fromRGB(255, 255, 255)
                        h.FillTransparency = 0.3
                        h.OutlineTransparency = 0
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        h.Parent = part
                    end
                end
            else
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj.Name == "FarmHighlight" then obj:Destroy() end
                end
            end
            task.wait(1.5)
        end
    end)
end

-- ==================== GENERIC EXTRACTOR ====================
local function isLiveTarget(container, state)
    if not container or not container.Parent then return false end
    if state.Blacklist[container] then return false end
    if container:IsA("Model") and (container:FindFirstChildOfClass("Humanoid")
        or Players:GetPlayerFromCharacter(container)) then return false end
    return true
end

local function resolveTarget(container)
    local prompt = container:FindFirstChildWhichIsA("ProximityPrompt", true)
    local touch  = container:FindFirstChildWhichIsA("TouchTransmitter", true)
    local part
    if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
        part = prompt.Parent
    elseif touch and touch.Parent and touch.Parent:IsA("BasePart") then
        part = touch.Parent
    elseif container:IsA("BasePart") then
        part = container
    elseif container:IsA("Model") then
        part = container.PrimaryPart or container:FindFirstChildWhichIsA("BasePart", true)
    end
    if part and part:IsA("BasePart") then
        if not prompt then
            prompt = part:FindFirstChildOfClass("ProximityPrompt")
                or (part.Parent and part.Parent:FindFirstChildOfClass("ProximityPrompt"))
        end
        return { Part = part, Prompt = prompt, Source = container }
    end
    return nil
end

-- ==================== CANDY ====================
local CandyState = newState(0.08)
local function scanCandy()
    local search = Workspace:FindFirstChild("OthersSpecialEvents")
    search = search and search:FindFirstChild("CandySearch")
    if not search then return end
    for _, slot in ipairs(search:GetChildren()) do
        for _, child in ipairs(slot:GetChildren()) do
            if child.Name ~= "Spawn" and not child:IsA("Attachment") and isLiveTarget(child, CandyState) then
                local d = resolveTarget(child)
                if d then pushToStaging(CandyState, d) end
            end
        end
    end
    local spawned = Workspace:FindFirstChild("SpawnedCandies")
    if spawned then
        for _, child in ipairs(spawned:GetChildren()) do
            if isLiveTarget(child, CandyState) then
                local d = resolveTarget(child)
                if d then pushToStaging(CandyState, d) end
            end
        end
    end
    commitStaging(CandyState)
end

-- ==================== POTIONS ====================
local PotionState = newState(0.08)
local function nameMatchesPotion(n)
    n = n:lower()
    return n:find("lb") or n:find("potion") or n:find("bottle") or n:find("chest")
end

local function scanPotions()
    local ev = Workspace:FindFirstChild("OthersSpecialEvents")
    if ev then
        for _, obj in ipairs(ev:GetChildren()) do
            if obj.Name ~= "CandySearch" then
                for _, desc in ipairs(obj:GetDescendants()) do
                    if not desc:IsA("Attachment") and desc.Name ~= "Spawn"
                        and nameMatchesPotion(desc.Name) and isLiveTarget(desc, PotionState) then
                        local d = resolveTarget(desc)
                        if d and (not d.Source.Name:lower():find("chest") or (d.Prompt and d.Prompt.Enabled)) then
                            pushToStaging(PotionState, d)
                        end
                    end
                end
            end
        end
    end
    for _, obj in ipairs(Workspace:GetChildren()) do
        if nameMatchesPotion(obj.Name) and isLiveTarget(obj, PotionState) then
            local d = resolveTarget(obj)
            if d then pushToStaging(PotionState, d) end
        end
    end
    commitStaging(PotionState)
end

-- ==================== BEWITCHED ====================
local BewitchedState = newState(0.08)
local function nameMatchesBewitched(n)
    n = n:lower()
    return n:find("bewitchede") or n:find("bewitchedenergy")
end

local function scanBewitched()
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if nameMatchesBewitched(desc.Name) and isLiveTarget(desc, BewitchedState) then
            local d = resolveTarget(desc)
            if d then pushToStaging(BewitchedState, d) end
        end
    end
    commitStaging(BewitchedState)
end

-- ==================== SCAN LOOPS (event-driven, slower timers) ====================
task.spawn(function()
    while true do
        if CandyState.Enabled then scanCandy(); pruneDead(CandyState) end
        if PotionState.Enabled then scanPotions(); pruneDead(PotionState) end
        if BewitchedState.Enabled then scanBewitched(); pruneDead(BewitchedState) end
        task.wait(1.5)
    end
end)

Workspace.DescendantAdded:Connect(function(desc)
    if desc:IsA("Attachment") then return end
    local n = desc.Name:lower()
    if (CandyState.Enabled and (n:find("candy") or desc.Parent and desc.Parent.Name:lower():find("candy"))) then
        task.spawn(scanCandy)
    end
    if PotionState.Enabled and (n:find("lb") or n:find("potion") or n:find("bottle")) then
        task.spawn(scanPotions)
    end
    if BewitchedState.Enabled and nameMatchesBewitched(n) then
        task.spawn(scanBewitched)
    end
end)

-- ==================== ITEM USERS ====================
local function useToolMatching(state_matcher)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and state_matcher(item.Name) then
                pcall(function() item:Activate() end)
            end
        end
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") and state_matcher(item.Name) then
                    item.Parent = char
                    task.wait(0.05)
                    pcall(function() item:Activate() end)
                    break
                end
            end
        end
    end)
end

local candyMatch = function(n)
    n = n:lower()
    return n:find("candy") or n:find("chocolate") or n:find("choco")
        or n:find("lolipop") or n:find("lollipop")
end
local potionMatch = function(n)
    n = n:lower()
    return n:find("lb") or n:find("potion") or n:find("bottle")
end

setupESP(CandyState, Color3.fromRGB(255, 120, 0))
setupESP(PotionState, Color3.fromRGB(0, 180, 255))
setupESP(BewitchedState, Color3.fromRGB(138, 43, 226))

farmLoop(CandyState, function()
    if CandyState.AutoEat then useToolMatching(candyMatch) end
end, nil)

farmLoop(PotionState, function()
    if PotionState.AutoUse then useToolMatching(potionMatch) end
end, nil)

farmLoop(BewitchedState, nil, 10)

-- ==================== DESOLATION ORB ====================
local function snipeDesoOrb(orb)
    if not GlobalState.AutoDesoOrb or not orb then return end
    task.spawn(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local part = orb:IsA("BasePart") and orb or orb:FindFirstChildWhichIsA("BasePart", true)
        if not part then return end
        for _ = 1, 12 do
            if not orb.Parent then break end
            local prompt = orb:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.Enabled then
                patchPrompt(prompt)
                safeFirePrompt(prompt)
            end
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = part.CFrame + Vector3.new(0, 1, 0)
            RunService.Heartbeat:Wait()
        end
    end)
end

Workspace.DescendantAdded:Connect(function(desc)
    if desc:IsA("ProximityPrompt") and GlobalState.InstantPromptsEnabled then
        patchPrompt(desc)
    end
    local n = desc.Name:lower()
    if n:find("desolationorb") then
        snipeDesoOrb(desc.Parent or desc)
    end
end)

-- ==================== HITBOX (gated, debounced) ====================
local OriginalProps = {}
local HITBOX_TICK = 1 / 5
local lastHitboxPulse = 0

local function saveAndExpand(part)
    if not OriginalProps[part] then
        OriginalProps[part] = {
            Size = part.Size,
            Transparency = part.Transparency,
            Color = part.Color,
            Material = part.Material,
            CanCollide = part.CanCollide,
            Massless = part.Massless,
        }
    end
    local s = math.clamp(GlobalState.HitboxSize, 2, 100)
    part.Size = Vector3.new(s, s, s)
    part.CanCollide = false
    part.Massless = true
    if GlobalState.HitboxVisual then
        part.Transparency = 0.65
        part.Color = Color3.fromRGB(200, 0, 255)
        part.Material = Enum.Material.Neon
    else
        part.Transparency = 1
    end
end

local function restorePart(part)
    local p = OriginalProps[part]
    if not p then return end
    pcall(function()
        part.Size = p.Size
        part.Transparency = p.Transparency
        part.Color = p.Color
        part.Material = p.Material
        part.CanCollide = p.CanCollide
        part.Massless = p.Massless
    end)
    OriginalProps[part] = nil
end

local function restoreAll()
    for part in pairs(OriginalProps) do restorePart(part) end
end

RunService.Heartbeat:Connect(function()
    if not GlobalState.HitboxEnabled then return end
    local now = os.clock()
    if now - lastHitboxPulse < HITBOX_TICK then return end
    lastHitboxPulse = now

    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildWhichIsA("Tool")
    if not tool then return end
    local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
    if not handle then return end

    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("BasePart") then saveAndExpand(d) end
    end

    if not firetouch then return end
    local radius = GlobalState.HitboxSize / 2
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local ec = plr.Character
            local hum = ec and ec:FindFirstChildOfClass("Humanoid")
            local er = ec and (ec:FindFirstChild("HumanoidRootPart") or ec:FindFirstChild("Head"))
            if hum and hum.Health > 0 and er then
                if (er.Position - handle.Position).Magnitude <= radius then
                    safeTouch(handle, er)
                end
            end
        end
    end
end)

