-- ==================== SWORD HITBOX EXPANDER & ULTRA-OPTIMIZED AURA ====================
local OriginalToolProps = {}

local function restoreToolHitbox(tool)
    if not tool then return end
    for _, desc in ipairs(tool:GetDescendants()) do
        if OriginalToolProps[desc] then
            pcall(function()
                if desc:IsA("BasePart") then
                    desc.Size = OriginalToolProps[desc].Size
                    desc.Transparency = OriginalToolProps[desc].Transparency
                    desc.Color = OriginalToolProps[desc].Color
                    desc.Material = OriginalToolProps[desc].Material
                    desc.CanCollide = OriginalToolProps[desc].CanCollide
                    desc.Massless = OriginalToolProps[desc].Massless
                elseif desc:IsA("SpecialMesh") then
                    desc.Scale = OriginalToolProps[desc].Scale
                end
            end)
            OriginalToolProps[desc] = nil
        end
    end
end

local function applySwordHitbox(tool)
    if not tool then return end
    for _, desc in ipairs(tool:GetDescendants()) do
        if desc:IsA("BasePart") then
            if not OriginalToolProps[desc] then
                OriginalToolProps[desc] = {
                    Size = desc.Size,
                    Transparency = desc.Transparency,
                    Color = desc.Color,
                    Material = desc.Material,
                    CanCollide = desc.CanCollide,
                    Massless = desc.Massless
                }
            end
            -- Safety cap size at 100 max to eliminate extreme game lag
            local safeSize = math.clamp(GlobalState.HitboxSize, 2, 100)
            desc.Size = Vector3.new(safeSize, safeSize, safeSize)
            desc.CanCollide = false
            desc.Massless = true
            desc.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

            if GlobalState.HitboxVisual then
                desc.Transparency = 0.65
                desc.Color = Color3.fromRGB(200, 0, 255)
                desc.Material = Enum.Material.Neon
            else
                desc.Transparency = 1
            end
        elseif desc:IsA("SpecialMesh") then
            if not OriginalToolProps[desc] then
                OriginalToolProps[desc] = { Scale = desc.Scale }
            end
            local safeSize = math.clamp(GlobalState.HitboxSize, 2, 100)
            desc.Scale = Vector3.new(safeSize, safeSize, safeSize)
        end
    end
end

